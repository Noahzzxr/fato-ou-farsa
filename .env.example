# Copie para .env e preencha. Nunca coloque chaves reais neste arquivo.

# --- Google Gemini --------------------------------------------------------------
# Usado na checagem das afirmações (com Google Search) e na classificação.
# Sem chave, o app funciona só com a base local de checagens.
# Chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="SUA_CHAVE_GEMINI_API_AQUI"
# GEMINI_MODEL="gemini-3.8-flash"

# --- PostZen (dados do TikTok) ------------------------------------------------
# Única credencial necessária para ler contas TikTok conectadas (somente leitura).
# Fica só no servidor: não exponha no frontend nem em logs.
# Para iniciar conexões OAuth pelo app (/v1/connect/tiktok) a chave precisa ser Read & Write.
# Docs: https://docs.postzen.dev/platforms/tiktok
POSTZEN_API_KEY="replace_with_your_new_key"
# POSTZEN_BASE_URL="https://api.postzen.dev"

# --- Django -------------------------------------------------------------------
# DJANGO_SECRET_KEY="troque-em-producao"
# DJANGO_DEBUG="True"
# PYTHON_BACKEND_PORT=5001

# --- Servidor -----------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
